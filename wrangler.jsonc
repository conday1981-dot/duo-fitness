// DUO on Cloudflare: one Worker serves the web app (dist/) and the sync relay (/api/*).
// Deploy:  npm run build:web && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "duo-relay", "database_id": "03b2c4ad-b141-4d30-928b-8b6b63a7e590", "migrations_dir": "worker/migrations" }
  ],
  "observability": { "enabled": false }
}
